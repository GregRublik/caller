# LLM (vLLM) settings — copy to llm/.env (never commit real values).

# Hugging Face access (needed to download the model on first start).
HF_TOKEN=

# Model
LLM_MODEL_ID=Qwen/Qwen3-14B-FP8
LLM_MODEL=qwen3-14b
LLM_MAX_MODEL_LEN=8192

# Share of VRAM reserved by vLLM. Raise to 0.90 if the GPU is used only by
# the LLM; keep 0.40-0.50 when STT/TTS also live on the same GPU.
GPU_MEMORY_UTILIZATION=0.40

# Bearer key the agent passes as VLLM_API_KEY.
VLLM_API_KEY=

# Blackwell (RTX PRO 6000) workaround: DeepGEMM crashed for Qwen3-14B-FP8.
VLLM_USE_DEEP_GEMM=0
VLLM_MOE_USE_DEEP_GEMM=0
