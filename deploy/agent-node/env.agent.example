# Agent-node .env (never commit real values).
# Copy to /workspace/caller/.env and chmod 600.

# --- LiveKit ----------------------------------------------------------------
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Tool services (launched separately) ------------------------------------
LLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
LLM_MODEL=qwen3-14b
STT_BASE_URL=http://127.0.0.1:8001
TTS_BASE_URL=http://127.0.0.1:8002

# --- Agent ------------------------------------------------------------------
AGENT_NAME=sales-agent
SIP_OUTBOUND_TRUNK_ID=
SIP_ANSWER_TIMEOUT=60
CONNECT_CHECK_TIMEOUT=8
RECORDINGS_DIR=/workspace/caller/recordings
LOG_LEVEL=INFO
