# Server-side .env for the GPU node (never commit real values).
# Copy to /workspace/caller/.env and chmod 600.

# --- Hugging Face -----------------------------------------------------------
HF_TOKEN=
HF_HOME=/workspace/.hf_home

# --- LLM (vLLM) -------------------------------------------------------------
# Qwen/Qwen3-14B-FP8 fits a 32 GB disk; use Qwen/Qwen3-14B (bf16) with 64 GB+.
LLM_MODEL_ID=Qwen/Qwen3-14B-FP8
LLM_MODEL=qwen3-14b
GPU_MEMORY_UTILIZATION=0.40
VLLM_API_KEY=

# --- STT (GigaAM) -----------------------------------------------------------
STT_MODEL_ID=ai-sage/GigaAM-v3
STT_MODEL_REVISION=e2e_rnnt
DEVICE=cuda

# --- TTS (ESpeech-TTS, F5-TTS architecture, voice cloning) ------------------
# Put a 5-15 s clean recording of the agent voice at TTS_REF_AUDIO and set
# TTS_REF_TEXT to its exact transcript (the same words). RUAccent adds
# Russian stress marks; nfe_step trades quality for speed (32 default).
TTS_MODEL_REPO=ESpeech/ESpeech-TTS-1_RL-V2
#TTS_MODEL_PATH=
#TTS_VOCAB_PATH=
TTS_REF_AUDIO=/workspace/caller/voice/ref.wav
TTS_REF_TEXT=
TTS_NFE_STEP=32
TTS_CHUNK_MS=100

# --- LiveKit (same key/secret as the server deployment) ---------------------
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent ------------------------------------------------------------------
AGENT_NAME=sales-agent
SIP_OUTBOUND_TRUNK_ID=
SIP_ANSWER_TIMEOUT=60
LOG_LEVEL=INFO
