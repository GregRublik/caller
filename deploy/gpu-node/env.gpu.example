# Server-side .env for the GPU node (never commit real values).
# Copy to /workspace/caller/.env and chmod 600.

# --- Hugging Face -----------------------------------------------------------
HF_TOKEN=
HF_HOME=/workspace/.hf_home

# --- LLM (vLLM) -------------------------------------------------------------
# Qwen/Qwen3-14B-FP8 fits a 32 GB disk; use Qwen/Qwen3-14B (bf16) with 64 GB+.
LLM_MODEL_ID=Qwen/Qwen3-14B-FP8
LLM_MODEL=qwen3-14b
GPU_MEMORY_UTILIZATION=0.40
VLLM_API_KEY=

# --- STT (GigaAM) -----------------------------------------------------------
STT_MODEL_ID=ai-sage/GigaAM-v3
STT_MODEL_REVISION=e2e_rnnt
DEVICE=cuda

# --- TTS (Qwen3-TTS) --------------------------------------------------------
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_SPEAKER=Aiden
TTS_LANGUAGE=ru
TTS_OUTPUT_SAMPLE_RATE=24000
TTS_CHUNK_MS=100
TTS_ATTN_IMPLEMENTATION=sdpa
# Voice stability: 0 = greedy decoding (same voice every sentence, default),
# 1 = sampling with the parameters below. TTS_SEED pins the RNG when sampling.
TTS_DO_SAMPLE=0
TTS_TEMPERATURE=0.7
TTS_TOP_K=20
TTS_TOP_P=0.9
TTS_REPETITION_PENALTY=1.05
TTS_SEED=

# --- LiveKit (same key/secret as the server deployment) ---------------------
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agent ------------------------------------------------------------------
AGENT_NAME=sales-agent
SIP_OUTBOUND_TRUNK_ID=
SIP_ANSWER_TIMEOUT=60
LOG_LEVEL=INFO
