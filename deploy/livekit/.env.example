# Copy to .env and fill in. Use the SAME API key/secret as in the project's
# root .env: the agent and the LiveKit server must agree on them.
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DNS A record for this name must point at the server's public IPv4.
# If there is no domain yet, a sslip.io name works for testing:
#   203-0-113-10.sslip.io
LIVEKIT_DOMAIN=livekit.example.com
