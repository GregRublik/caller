; Exolve BATC (VATС) trunk. This file is rendered at container start from
; pjsip.batc.conf.tmpl by entrypoint.sh; do not edit the generated file.
;
; The employee login/password come from scripts/batc.py create-agent and are
; stored in the project .env as BATC_AGENT_LOGIN / BATC_AGENT_PASSWORD.
;
; If inbound calls from BATC stop arriving, check the source IPs in
; [identify-batc] first: the SIP API documentation lists 80.75.130.100 and
; 80.75.130.101 for Exolve SIP traffic.

[batc-reg]
type=registration
transport=transport-udp
outbound_auth=batc-auth
server_uri=sip:${BATC_SIP_DOMAIN}:${BATC_SIP_PORT}
client_uri=sip:${BATC_SIP_LOGIN}@${BATC_SIP_DOMAIN}
contact_user=${BATC_SIP_LOGIN}
retry_interval=60
forbidden_retry_interval=300

[batc-auth]
type=auth
auth_type=userpass
username=${BATC_SIP_AUTH_USER}
password=${BATC_SIP_PASSWORD}

[batc]
type=endpoint
context=from-batc
disallow=all
allow=ulaw,alaw
outbound_auth=batc-auth
aors=batc
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user=${BATC_SIP_FROM_USER}
from_domain=${BATC_SIP_DOMAIN}

[batc]
type=aor
contact=sip:${BATC_SIP_LOGIN}@${BATC_SIP_DOMAIN}:${BATC_SIP_PORT}

[identify-batc]
type=identify
endpoint=batc
match=80.75.130.100,80.75.130.101
